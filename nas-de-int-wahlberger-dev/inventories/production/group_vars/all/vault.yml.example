# EXAMPLE Vault contents — copy the structure, NOT the placeholder values.
#
# This file is a committed, plaintext template. The REAL file is the encrypted
# sibling `vault.yml` (same directory). Create it with:
#
#     ansible-vault create inventories/production/group_vars/all/vault.yml
#
# then paste real values in. Every key is referenced from vars.yml under a
# friendly (non-vault_) name.

# PostgreSQL password shared by paperless-db and paperless-ngx.
# Migrating from rpi-karlsruhe? Copy the EXISTING value from its vault.yml —
# a new value here won't authenticate against the restored database dump.
#     openssl rand -hex 24
vault_paperless_ngx_db_password: "REPLACE-with-a-generated-password"

# Paperless-ngx OIDC client secret, issued by Pocket ID when you registered the
# app (the client_id lives in vars.yml). Migrating? Reuse the EXISTING secret —
# it belongs to the Pocket ID client registration, not to this host.
vault_paperless_ngx_oidc_client_secret: "REPLACE-with-pocket-id-client-secret"

# Tandoor's PostgreSQL role password (tandoor + tandoor-db) and Django
# SECRET_KEY. Freshly generated — no migration/reuse concern.
#     openssl rand -hex 24
vault_tandoor_db_password: "REPLACE-with-a-generated-password"
vault_tandoor_secret_key: "REPLACE-with-a-generated-secret-key"

# Tandoor OIDC client secret, issued by Pocket ID when you manually register
# a NEW Tandoor client (do NOT reuse Mealie's old client — see
# roles/tandoor/README.md). Register that client first; the role's FR-12
# assert fails cleanly until this is filled in.
vault_tandoor_oidc_client_secret: "REPLACE-with-the-Pocket-ID-client-secret"

# PostgreSQL password for Immich's database.
#     openssl rand -hex 24
vault_immich_db_password: "REPLACE-with-a-generated-password"

# Immich OIDC client secret, issued by Pocket ID when you register the app —
# see roles/immich/README.md for the exact redirect URIs to use.
vault_immich_oidc_client_secret: "REPLACE-with-pocket-id-client-secret"

# Forgejo secrets. Generate the four keys with Forgejo itself (no state is
# touched, the container is discarded):
#     podman run --rm codeberg.org/forgejo/forgejo:15-rootless forgejo generate secret SECRET_KEY
#     podman run --rm codeberg.org/forgejo/forgejo:15-rootless forgejo generate secret INTERNAL_TOKEN
#     podman run --rm codeberg.org/forgejo/forgejo:15-rootless forgejo generate secret JWT_SECRET
#     podman run --rm codeberg.org/forgejo/forgejo:15-rootless forgejo generate secret LFS_JWT_SECRET
# Losing SECRET_KEY makes stored 2FA seeds/secrets undecryptable, so keep a
# copy outside Vault too (the restic backup contains app.ini, but needs the
# restic password, which itself lives here).
vault_forgejo_secret_key: "REPLACE-with-generated-SECRET_KEY"
vault_forgejo_internal_token: "REPLACE-with-generated-INTERNAL_TOKEN"
vault_forgejo_oauth2_jwt_secret: "REPLACE-with-generated-JWT_SECRET"
vault_forgejo_lfs_jwt_secret: "REPLACE-with-generated-LFS_JWT_SECRET"

# Password of the local Forgejo admin account (break-glass; day-to-day login
# is Pocket ID).
#     openssl rand -hex 24
vault_forgejo_admin_password: "REPLACE-with-a-generated-password"

# Forgejo OIDC client secret, issued by Pocket ID when you register the
# Forgejo client — see roles/forgejo/README.md for the redirect URI.
vault_forgejo_oidc_client_secret: "REPLACE-with-pocket-id-client-secret"

# Cloudflare DNS API token for Caddy's DNS-01 challenge — scoped to
# Zone:DNS:Edit on the wahlberger.dev zone, nothing broader. Migrating from
# rpi-karlsruhe? Its Traefik role already uses a token for the same zone —
# reuse it instead of minting a new one.
vault_cloudflare_dns_api_token: "REPLACE-with-a-cloudflare-api-token"

# RESTORE-ONLY: kept solely to restore from the Pi's frozen `nas` restic
# repository (the old NAS-to-Pi job is removed); no role reads it any more.
# restic repository encryption password. Keep a copy outside Vault too (e.g.
# 1Password) — losing this makes that frozen repository unrecoverable.
#     LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 40; echo
vault_restic_backup_repo_password: "REPLACE-with-a-40-char-alnum-password"

# RESTORE-ONLY, see above: access to the Pi's frozen `nas` repository.
# restic REST server auth password. SHARED SECRET: must be the exact same
# value as pi-de-int-wahlberger-dev's vault_restic_server_htpasswd_password.
vault_restic_backup_rest_server_password: "REPLACE-with-a-32-char-alnum-password"

# restic REST server (restic_server role), client `cloud`. SHARED SECRET: must
# be the exact same value as cloud-wahlberger-dev's
# vault_restic_backup_rest_server_password (and the Pi's current
# vault_restic_server_cloud_htpasswd_password it replaces).
vault_restic_server_cloud_htpasswd_password: "REPLACE-with-the-cloud-rest-server-password"

# Repository password of cloud's restic repository, used by the maintenance
# run. Must be the exact same value as cloud-wahlberger-dev's
# vault_restic_backup_repo_password.
vault_restic_server_cloud_repo_password: "REPLACE-with-cloud-restic-repo-password"

# Resend API key for failure notification emails. Same key as
# cloud-wahlberger-dev and pi-de-int-wahlberger-dev — one Resend account.
vault_notify_failure_resend_api_key: "REPLACE-with-a-resend-api-key"
