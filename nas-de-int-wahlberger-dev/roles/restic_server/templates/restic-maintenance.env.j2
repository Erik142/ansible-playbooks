# Managed by Ansible. Read by systemd (as root) into restic-server-maintenance.service.
# One RESTIC_PASSWORD_<REPO> line per maintained repository (repo name upper-cased,
# non-alphanumerics replaced by _); the script passes only its own to restic.
{% for entry in restic_server_maintenance_repos %}
RESTIC_PASSWORD_{{ entry.repo | regex_replace('[^A-Za-z0-9]', '_') | upper }}="{{ entry.password | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% endfor %}
