#!/bin/sh
# Managed by Ansible (role smartd). Do NOT edit on the host.
# smartd mail hook (-M exec): reports the warning to hush, which e-mails the owner
# (SM-FR-3, SM-FR-4). smartd passes
# SMARTD_DEVICE, SMARTD_MESSAGE, SMARTD_FULLMESSAGE and SMARTD_FAILTYPE.
set -eu

ENV_FILE=/etc/hush/hook.env
if [ ! -r "$ENV_FILE" ]; then
  echo "smartd-notify: $ENV_FILE missing (notify_failure role not applied)" >&2
  exit 1
fi
# hook.env holds plain KEY=value lines; export them for hush-post.
set -a
# shellcheck source=/dev/null
. "$ENV_FILE"
set +a

DEVICE="${SMARTD_DEVICE:-unknown device}"
MESSAGE="${SMARTD_FULLMESSAGE:-${SMARTD_MESSAGE:-no message from smartd}}"
HOST="${HUSH_HOST:-$(hostname -f)}"

# A smartd warning is a problem event for this device; hush decides on the mail.
printf '%s\n' "$MESSAGE" | HUSH_MESSAGE="smartd reported a problem with $DEVICE on $HOST." \
  /usr/local/bin/hush-post problem "$HOST" "smartd:$DEVICE"
