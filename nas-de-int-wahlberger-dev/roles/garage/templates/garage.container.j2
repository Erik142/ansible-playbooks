[Unit]
Description=Garage S3 object store
After=network-online.target
Wants=network-online.target
# Both subvolumes live on separate filesystems: do not start without them.
RequiresMountsFor={{ garage_mount_path }} {{ garage_config_dir }}
# Emails the owner via the notify_failure role after 5 failures in 10 minutes
# (flap-limited, like restic-server) instead of one email per restart.
OnFailure=notify-failure@%n.service

[Container]
ContainerName=garage
Image={{ garage_image }}
# Only the shared Caddy network: no PublishPort, so no Garage port (3900-3903)
# is reachable on any host address. Caddy reaches garage:3900 / garage:3902.
Network=caddy.network
# Numeric ids of {{ garage_user }}: never root. Set at run time (getent).
User={{ garage_uid }}
Group={{ garage_gid }}
# Container paths equal host paths. `:Z` relabels only these two directories;
# no Volume= for the subvolume root, the config directory as a whole or a
# snapshot directory, so a read-only btrbk snapshot is never relabelled.
Volume={{ garage_store_path }}/data:{{ garage_store_path }}/data:Z
Volume={{ garage_meta_path }}:{{ garage_meta_path }}:Z
Volume={{ garage_config_dir }}/garage.toml:{{ garage_config_dir }}/garage.toml:ro
Volume={{ garage_secrets_dir }}:{{ garage_secrets_dir }}:ro
# Config file location: to verify against v2.4.1 in spike T-02 / task T-10.
Environment=GARAGE_CONFIG_FILE={{ garage_config_dir }}/garage.toml
HealthCmd=["/garage","status"]
# Lets Restart=always restart an unhealthy container.
HealthOnFailure=kill

[Service]
Restart=always

[Install]
WantedBy=default.target
