{# Rendered by the mealie role to {{ mealie_data_dir }}/mealie.env (0600). #}
{# podman EnvironmentFile format: KEY=VALUE, one per line; the value is the #}
{# rest of the line verbatim. Holds the OIDC client secret so it never lands #}
{# in the world-readable Quadlet unit. Do NOT edit on the host. #}

# --- OpenID Connect via Pocket ID ------------------------------------------
OIDC_AUTH_ENABLED=true
OIDC_CONFIGURATION_URL={{ pocket_id_app_url }}/.well-known/openid-configuration
OIDC_CLIENT_ID={{ mealie_oidc_client_id }}
OIDC_CLIENT_SECRET={{ mealie_oidc_client_secret }}
OIDC_PROVIDER_NAME={{ mealie_oidc_provider_name }}
# Claim matched against existing Mealie user emails to map logins to accounts.
OIDC_USER_CLAIM={{ mealie_oidc_user_claim }}
# Auto-provision a Mealie account on first OIDC login (false => map-only).
OIDC_SIGNUP_ENABLED={{ mealie_oidc_signup_enabled | ternary('true', 'false') }}
# Skip Mealie's own login page and go straight to Pocket ID.
OIDC_AUTO_REDIRECT={{ mealie_oidc_auto_redirect | ternary('true', 'false') }}
OIDC_REMEMBER_ME=true
{% if mealie_oidc_user_group | length > 0 %}
# Only Pocket ID users in this group may sign in.
OIDC_USER_GROUP={{ mealie_oidc_user_group }}
{% endif %}
{% if mealie_oidc_admin_group | length > 0 %}
# Members of this group additionally become Mealie admins.
OIDC_ADMIN_GROUP={{ mealie_oidc_admin_group }}
{% endif %}
