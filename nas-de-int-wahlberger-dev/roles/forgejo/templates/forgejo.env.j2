{# Rendered by the forgejo role to {{ forgejo_data_dir }}/forgejo.env (0600). #}
{# podman EnvironmentFile format: KEY=VALUE, one per line, value verbatim. #}
{# Holds every Forgejo secret so none lands in the world-readable Quadlet #}
{# unit. The rootless image's environment-to-ini writes FORGEJO__<SECTION>__<KEY> #}
{# into app.ini on every start. Do NOT edit on the host -- re-run Ansible. #}
FORGEJO__security__SECRET_KEY={{ forgejo_secret_key }}
FORGEJO__security__INTERNAL_TOKEN={{ forgejo_internal_token }}
FORGEJO__oauth2__JWT_SECRET={{ forgejo_oauth2_jwt_secret }}
FORGEJO__server__LFS_JWT_SECRET={{ forgejo_lfs_jwt_secret }}
