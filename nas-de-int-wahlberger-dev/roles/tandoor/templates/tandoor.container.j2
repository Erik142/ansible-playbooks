[Unit]
Description=Tandoor Recipes recipe manager
After=network-online.target caddy-network.service tandoor-db.service
Wants=network-online.target tandoor-db.service
Requires=caddy-network.service
# Emails ewahlberger@gmail.com via Resend after 5 consecutive failures —
# see the notify_failure role.
OnFailure=notify-failure@%n.service

[Container]
ContainerName=tandoor
Image={{ tandoor_image }}
Network=caddy.network
Network=tandoor
Volume={{ tandoor_data_dir }}/mediafiles:/opt/recipes/mediafiles:Z
Environment=DB_ENGINE=django.db.backends.postgresql
Environment=POSTGRES_HOST=tandoor-db
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_DB=tandoor
Environment=POSTGRES_USER=tandoor
Environment=TZ={{ tandoor_timezone }}
# Non-secret base config only, set directly since it carries no secret value
# (FR-24).
Environment=CSRF_TRUSTED_ORIGINS={{ tandoor_url }}
# --- Auth hardening (FR-21) --------------------------------------------
# Closes local password registration. Confirmed against upstream during the
# T-01 spike (2026-09-27): does not block auto-provisioning of new accounts
# via Pocket ID sign-in (A-11, FR-19).
Environment=ENABLE_SIGNUP=0
# Disables local username/password authentication at the allauth level
# entirely -- a stronger closure than only hiding the login form. The
# `manage.py createsuperuser` recovery path (FR-56) still works regardless
# of this setting.
Environment=SOCIALACCOUNT_ONLY=1
# SECRET_KEY, the POSTGRES_PASSWORD matching tandoor-db.env, and every OIDC
# setting are wired in via a root-only env file (the same EnvironmentFile=
# pattern as roles/paperless_ngx/templates/paperless-ngx.container.j2).
EnvironmentFile={{ tandoor_data_dir }}/tandoor.env

[Service]
Restart=always

[Install]
WantedBy=default.target
