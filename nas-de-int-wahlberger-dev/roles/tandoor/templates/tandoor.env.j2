{# Rendered by the tandoor role to {{ tandoor_data_dir }}/tandoor.env (0600). #}
{# podman EnvironmentFile format: KEY=VALUE, one per line; the value is the #}
{# rest of the line verbatim (no quoting, no shell/JSON parsing by podman). #}
{# Holds the Django SECRET_KEY, the tandoor-db role password and the full #}
{# OIDC config so none of it lands in the world-readable Quadlet unit. #}
{# Do NOT edit on the host -- re-run Ansible. #}
SECRET_KEY={{ tandoor_secret_key }}
POSTGRES_PASSWORD={{ tandoor_db_password }}

# --- OpenID Connect via Pocket ID (django-allauth) -------------------------
# Enables the allauth OIDC provider app (same shape as paperless_ngx's
# PAPERLESS_APPS / roles/paperless_ngx/templates/paperless-ngx.env.j2).
SOCIAL_PROVIDERS=allauth.socialaccount.providers.openid_connect
# Single-line JSON. server_url is Pocket ID's discovery document;
# provider_id must match the callback URL registered in Pocket ID
# (https://{{ tandoor_url }}/accounts/oidc/{{ tandoor_oidc_provider_id }}/login/callback/,
# confirmed against the Pocket ID Tandoor guide during the T-01 spike,
# A-04/FR-17). PKCE is enabled (FR-18/AC-15).
SOCIALACCOUNT_PROVIDERS={{ {
  "openid_connect": {
    "APPS": [{
      "provider_id": tandoor_oidc_provider_id,
      "name": tandoor_oidc_provider_name,
      "client_id": tandoor_oidc_client_id,
      "secret": tandoor_oidc_client_secret,
      "settings": {"server_url": pocket_id_app_url ~ "/.well-known/openid-configuration"},
    }],
    "OAUTH_PKCE_ENABLED": true,
  }
} | tojson }}
