[Unit]
Description=n8n workflow automation (editor, phase 1: no workflows)
After=network-online.target caddy-network.service
Wants=network-online.target
Requires=caddy-network.service
# Emails via Resend after failures, see the notify_failure role.
OnFailure=notify-failure@%n.service

[Container]
ContainerName=n8n
Image={{ n8n_image }}
Network=caddy.network
# No PublishPort: Caddy reaches n8n:{{ n8n_port }} over caddy.network.
Volume={{ n8n_volume_dir }}:/home/node/.n8n:Z
Environment=TZ={{ n8n_timezone }}
Environment=GENERIC_TIMEZONE={{ n8n_timezone }}
Environment=N8N_HOST={{ n8n_url | urlsplit('hostname') }}
Environment=N8N_PORT={{ n8n_port }}
Environment=N8N_PROTOCOL=https
Environment=N8N_EDITOR_BASE_URL={{ n8n_url }}/
Environment=WEBHOOK_URL={{ n8n_url }}/
Environment=N8N_SECURE_COOKIE=true
# One proxy hop: Caddy. oauth2-proxy is a forward_auth subrequest, not a hop.
Environment=N8N_PROXY_HOPS=1
# Phone-home off. Verified against n8n's isolation guide, not against the running version.
Environment=N8N_DIAGNOSTICS_ENABLED=false
Environment=N8N_VERSION_NOTIFICATIONS_ENABLED=false
Environment=N8N_TEMPLATES_ENABLED=false
Environment=N8N_PERSONALIZATION_ENABLED=false
Environment=NODES_EXCLUDE={{ n8n_nodes_exclude }}
# File access limited to the data dir. Subdirectory handling is reported as fiddly on 2.x:
# verify on the running version before relying on it.
Environment=N8N_RESTRICT_FILE_ACCESS_TO=/home/node/.n8n
Environment=N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true
# N8N_ENCRYPTION_KEY: root-only env file, same EnvironmentFile= pattern as roles/forgejo.
EnvironmentFile={{ n8n_data_dir }}/n8n.env

[Service]
Restart=always
MemoryMax={{ n8n_memory_max }}
CPUQuota={{ n8n_cpu_quota }}

[Install]
WantedBy=default.target
