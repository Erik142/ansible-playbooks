# Rendered by the n8n role to {{ n8n_data_dir }}/n8n.env (0600). Do NOT edit on the host: re-run Ansible.
# The encryption key is not here: it is a file (encryption.key, N8N_ENCRYPTION_KEY_FILE).
# Triage workflow secrets (architecture/n8n-triage-workflow.md). Env access is open to
# workflows, so keep only these two in this file.
HUSH_N8N_SECRET={{ n8n_hush_secret }}
ANTHROPIC_API_KEY={{ n8n_anthropic_key }}
# Renovate gate, monitor-only: fine-grained read-only token (contents, pull requests, checks).
GITHUB_TOKEN_MONITOR={{ n8n_github_token }}
