# Rendered by the n8n role to {{ n8n_data_dir }}/oauth2-proxy.env (0600). Do NOT edit on the host — re-run Ansible.
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ pocket_id_app_url }}
OAUTH2_PROXY_CLIENT_ID={{ n8n_oidc_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ n8n_oidc_client_secret }}
OAUTH2_PROXY_COOKIE_SECRET={{ n8n_oauth2_cookie_secret }}
OAUTH2_PROXY_REDIRECT_URL={{ n8n_url }}/oauth2/callback
OAUTH2_PROXY_SCOPE=openid email profile
# Only the emails in the allowlist file get through. Not "any Pocket ID account".
OAUTH2_PROXY_AUTHENTICATED_EMAILS_FILE=/etc/oauth2-proxy/emails.txt
# Put X-Auth-Request-Email on the /oauth2/auth response; Caddy copies it into the request
# for n8n, where hooks.js reads it.
OAUTH2_PROXY_SET_XAUTHREQUEST=true
# forward_auth only calls /oauth2/auth; Caddy proxies the editor itself.
OAUTH2_PROXY_UPSTREAMS=static://200
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:{{ n8n_oauth2_proxy_port }}
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
