[Unit]
Description=oauth2-proxy (Pocket ID auth gate for n8n editor)
After=network-online.target caddy-network.service
Wants=network-online.target
Requires=caddy-network.service
OnFailure=notify-failure@%n.service

[Container]
ContainerName=oauth2-proxy
Image={{ n8n_oauth2_proxy_image }}
Network=caddy.network
EnvironmentFile={{ n8n_data_dir }}/oauth2-proxy.env
Volume={{ n8n_data_dir }}/oauth2-proxy-emails.txt:/etc/oauth2-proxy/emails.txt:ro,Z

[Service]
# SIGTERM (143) is the normal stop of a container; systemd would count it as a failure and fire OnFailure=.
SuccessExitStatus=143
Restart=always

[Install]
WantedBy=default.target
