{# Rendered by the paperless_ngx role to {{ paperless_ngx_data_dir }}/paperless-ngx.env (0600). #}
{# podman EnvironmentFile format: KEY=VALUE, one per line; the value is the #}
{# rest of the line verbatim (no quoting, no shell/JSON parsing by podman). #}
{# Holds the DB password and the full OIDC config so neither lands in the #}
{# world-readable Quadlet unit. Do NOT edit on the host — re-run Ansible. #}
PAPERLESS_URL={{ paperless_ngx_url }}
PAPERLESS_DBPASS={{ paperless_ngx_db_password }}

# --- OpenID Connect via Pocket ID (django-allauth) -------------------------
# Enable the allauth OIDC provider app.
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
# Single-line JSON. server_url is Pocket ID's discovery document; provider_id
# must match the callback URL registered in Pocket ID. PKCE is enabled.
PAPERLESS_SOCIALACCOUNT_PROVIDERS={"openid_connect":{"APPS":[{"provider_id":"{{ paperless_ngx_oidc_provider_id }}","name":"{{ paperless_ngx_oidc_provider_name }}","client_id":"{{ paperless_ngx_oidc_client_id }}","secret":"{{ paperless_ngx_oidc_client_secret }}","settings":{"server_url":"{{ pocket_id_app_url }}/.well-known/openid-configuration"}}],"OAUTH_PKCE_ENABLED":true}}
# Account creation from OIDC. Both false => map to existing (linked) users only.
PAPERLESS_SOCIAL_AUTO_SIGNUP={{ paperless_ngx_oidc_auto_signup | ternary('true', 'false') }}
PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS={{ paperless_ngx_oidc_allow_signups | ternary('true', 'false') }}
# Disable the username/password form entirely (Pocket ID becomes the only way in).
PAPERLESS_DISABLE_REGULAR_LOGIN={{ paperless_ngx_disable_local_login | ternary('true', 'false') }}
# Send the login page straight to Pocket ID (true) or keep the local form (false).
PAPERLESS_REDIRECT_LOGIN_TO_SSO={{ paperless_ngx_oidc_redirect_login | ternary('true', 'false') }}
