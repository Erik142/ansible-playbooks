[Unit]
Description=Redis (Paperless-ngx cache/queue)
After=network-online.target
Wants=network-online.target
# Emails ewahlberger@gmail.com via Resend after 5 consecutive failures —
# see the notify_failure role.
OnFailure=notify-failure@%n.service

[Container]
ContainerName=paperless-redis
Image={{ paperless_ngx_redis_image }}
Network=paperless-ngx
Volume={{ paperless_ngx_redis_data_dir }}:/data:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
