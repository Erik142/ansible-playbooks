#!/bin/sh
# Rendered by the reboot_notify role. Do NOT edit on the host — re-run
# Ansible. Called directly by security's request-reboot-if-needed.sh, right
# after it requests a reboot via rebootmgrctl — not a shutdown-time systemd
# hook (this role's design until 2026-09; confirmed unreliable in practice,
# see README.md). Only actually emails when zypper itself says a reboot is
# genuinely needed, matching the same check the caller already made.
set -eu

if OUTPUT="$(zypper needs-rebooting 2>&1)"; then
  RC=0
else
  RC=$?
fi

# 102 = ZYPPER_EXIT_INF_REBOOT_NEEDED. Anything else (0 = not needed, or a
# real zypper error) means there's nothing accurate to email about.
[ "$RC" -eq 102 ] || exit 0

# shellcheck disable=SC1091
. /etc/notify-failure/notify-failure.env
TEMPLATE=/etc/reboot-notify/email-template.html
HOST="$(hostname -f)"
NOW="$(date '+%Y-%m-%d %H:%M:%S %Z')"

BODY="$(jq -n \
  --arg from "$NOTIFY_FROM" \
  --arg to "$NOTIFY_TO" \
  --arg host "$HOST" \
  --arg time "$NOW" \
  --arg packages "$OUTPUT" \
  --rawfile tmpl "$TEMPLATE" \
  '{
    from: $from,
    to: [$to],
    subject: ("[" + $host + "] Reboot needed for a pending update"),
    text: ($host + " needs a reboot for a pending software update, detected at " + $time + ".\n\nA reboot has just been requested via rebootmgr (strategy: {{ security_autoupdate_reboot_strategy | default('best-effort') }}) and will happen automatically soon — not necessarily immediately. There is no further email when that actually happens; Uptime Kuma will show the resulting brief downtime independently, whenever that turns out to be.\n\n" + $packages),
    html: ($tmpl
      | gsub("@@HOST@@"; $host)
      | gsub("@@TIME@@"; $time)
      | gsub("@@PACKAGES@@"; $packages))
  }' 2>&1)" || { echo "jq failed building the reboot notice body: $BODY" >&2; exit 0; }

curl -fsS --max-time 15 https://api.resend.com/emails \
  -H "Authorization: Bearer ${RESEND_API_KEY}" \
  -H "Content-Type: application/json" \
  -d "$BODY" || echo "Sending the reboot notice failed (reboot proceeds regardless)" >&2
