#!/bin/sh
# Rendered by the reboot_notify role. Do NOT edit on the host — re-run
# Ansible. Called directly by security's request-reboot-if-needed.sh, right
# after it requests a reboot via rebootmgrctl — not a shutdown-time systemd
# hook (this role's design until 2026-09; confirmed unreliable in practice,
# see README.md). Only actually emails when zypper itself says a reboot is
# genuinely needed, matching the same check the caller already made.
set -eu

if OUTPUT="$(zypper needs-rebooting 2>&1)"; then
  RC=0
else
  RC=$?
fi

# 102 = ZYPPER_EXIT_INF_REBOOT_NEEDED. Anything else (0 = not needed, or a
# real zypper error) means there's nothing accurate to email about.
[ "$RC" -eq 102 ] || exit 0

# shellcheck disable=SC1091
set -a  # export HUSH_TOKEN for hush-post
. /etc/notify-failure/notify-failure.env
set +a
HOST="$(hostname -f)"
NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Heads-up goes to hush as an info event with kind=heads_up: hush sends it at
# once, even inside a maintenance window (HUSH-RULES-050), and skips triage.
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT
jq -n \
  --arg host "$HOST" \
  --arg ts "$NOW" \
  --arg packages "$OUTPUT" \
  '{schema: "hush.event.v1", host: $host, check: "reboot-pending", service: "", status: "info",
    message: ($host + " needs a reboot for a pending software update. The reboot is requested via rebootmgr and happens inside the maintenance window, not immediately."),
    log_excerpt: $packages, labels: {kind: "heads_up"}, occurred_at: $ts}' > "$TMP" \
  || { echo "jq failed building the reboot notice" >&2; exit 0; }

/usr/local/bin/hush-post {{ notify_failure_hush_source }} bearer "$TMP" \
  || echo "Posting the reboot notice to hush failed (reboot proceeds regardless)" >&2
