#!/bin/sh
# Rendered by the notify_failure role. Do NOT edit on the host — re-run
# Ansible. RESEND_API_KEY/NOTIFY_FROM/NOTIFY_TO/NOTIFY_LOG_LINES/
# NOTIFY_CRASH_THRESHOLD/NOTIFY_CRASH_WINDOW_SECONDS come from
# notify-failure@.service's EnvironmentFile, not this script.
#
# Usage: notify-failure.sh <failed-unit-name>
set -eu

UNIT="${1:?usage: notify-failure.sh <unit-name>}"
HOST="$(hostname -f)"
NOW="$(date '+%Y-%m-%d %H:%M:%S %Z')"
TEMPLATE=/etc/notify-failure/email-template.html

# --- Crash-loop dedup: only email once a unit has failed
# NOTIFY_CRASH_THRESHOLD times within NOTIFY_CRASH_WINDOW_SECONDS, not on
# every single restart (OnFailure= fires on each one — a self-healing
# blip should never reach an inbox). State lives under /run (tmpfs): a
# fresh boot legitimately means "start counting again", and re-creating the
# directory here (rather than via Ansible) is required precisely because
# /run doesn't survive a reboot for Ansible to have pre-created it into.
STATE_DIR=/run/notify-failure
mkdir -p "$STATE_DIR"
STATE_FILE="$STATE_DIR/$UNIT"

NOW_EPOCH="$(date +%s)"
COUNT=0
LAST_EPOCH=0
[ -f "$STATE_FILE" ] && read -r COUNT LAST_EPOCH < "$STATE_FILE" || true

# Streak went quiet for longer than the window — this failure starts a new
# one, not a continuation of whatever happened before.
if [ $((NOW_EPOCH - LAST_EPOCH)) -gt "${NOTIFY_CRASH_WINDOW_SECONDS}" ]; then
  COUNT=0
fi
COUNT=$((COUNT + 1))
printf '%s %s\n' "$COUNT" "$NOW_EPOCH" > "$STATE_FILE"

if [ "$COUNT" -ne "${NOTIFY_CRASH_THRESHOLD}" ]; then
  echo "notify-failure: $UNIT failure #$COUNT in the current streak (threshold ${NOTIFY_CRASH_THRESHOLD}) — not emailing"
  exit 0
fi
STREAK="${NOTIFY_CRASH_THRESHOLD} failures in $((NOTIFY_CRASH_WINDOW_SECONDS / 60)) min"

# Scope the log query to the failed unit's own invocation, not its whole
# history — an id systemd assigns fresh to each start of the unit. Falls
# back to a plain unit-scoped query if that lookup ever comes back empty
# (e.g. the unit doesn't exist under that exact name for some reason).
INVOCATION_ID="$(systemctl show -p InvocationID --value "$UNIT" 2>/dev/null || true)"
if [ -n "$INVOCATION_ID" ]; then
  LOGS="$(journalctl "_SYSTEMD_INVOCATION_ID=${INVOCATION_ID}" --no-pager -n "${NOTIFY_LOG_LINES}" -o short-iso 2>/dev/null || true)"
else
  LOGS="$(journalctl -u "$UNIT" --no-pager -n "${NOTIFY_LOG_LINES}" -o short-iso 2>/dev/null || true)"
fi
[ -n "$LOGS" ] || LOGS="(no log output captured)"

# HTML-escape first, THEN wrap error-looking lines in a colored span — doing
# it in the other order would have the escape pass mangle the span tags
# themselves.
LOGS_HTML="$(printf '%s' "$LOGS" \
  | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' \
  | sed -E 's/^(.*(error|Error|ERROR|fail|Fail|FAILED|fatal|Fatal|FATAL).*)$/<span style="color:#ff8a80;">\1<\/span>/')"

BODY="$(jq -n \
  --arg from "$NOTIFY_FROM" \
  --arg to "$NOTIFY_TO" \
  --arg unit "$UNIT" \
  --arg host "$HOST" \
  --arg time "$NOW" \
  --arg logs "$LOGS" \
  --arg logs_html "$LOGS_HTML" \
  --arg log_caption "Last ${NOTIFY_LOG_LINES} log lines:" \
  --arg streak "$STREAK" \
  --rawfile tmpl "$TEMPLATE" \
  '{
    from: $from,
    to: [$to],
    subject: ("[" + $host + "] " + $unit + " failing repeatedly (" + $streak + ")"),
    text: ($unit + " has now failed " + $streak + " on " + $host + ", as of " + $time + ".\n\n" + $log_caption + "\n" + $logs + "\n\nFull history: journalctl -u " + $unit + " -e"),
    html: ($tmpl
      | gsub("@@UNIT@@"; $unit)
      | gsub("@@HOST@@"; $host)
      | gsub("@@TIME@@"; $time)
      | gsub("@@STREAK@@"; $streak)
      | gsub("@@LOG_CAPTION@@"; $log_caption)
      | gsub("@@LOGS@@"; $logs_html))
  }' 2>&1)" || { echo "jq failed building the request body: $BODY" >&2; exit 1; }

curl -fsS https://api.resend.com/emails \
  -H "Authorization: Bearer ${RESEND_API_KEY}" \
  -H "Content-Type: application/json" \
  -d "$BODY"
