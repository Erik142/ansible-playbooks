---
# yamllint settings aligned with how ansible-lint expects YAML to look.
# Check it with:  yamllint .
extends: default

rules:
  line-length:
    max: 160
    level: warning
  # Ansible-style booleans only.
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  # Required for compatibility with ansible-lint; also forbids ambiguous octal
  # like `0755` (always quote file modes as "0755" strings).
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  .ansible_cache/
  .ansible/
  # Encrypted Vault files are ciphertext, not real YAML — see .ansible-lint.
  **/vault.yml
