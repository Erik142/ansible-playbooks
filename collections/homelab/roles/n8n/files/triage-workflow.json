      "credentials": {
        "sshPrivateKey": {
          "id": "n8ndiagssh01",
          "name": "n8n-diag"
        }
      }
    },
    {
      "id": "assemble",
      "name": "Assemble",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "jsCode": "const plan = $('Plan').first().json;\nconst body = plan.body;\nlet diag = '';\ntry { diag = $('Run diagnostics').first().json.stdout || ''; } catch (e) { diag = ''; }\nconst redact = (value) => {\n  let r = String(value === undefined || value === null ? '' : value);\n  if (body.host) r = r.split(body.host).join('<host>');\n  return r.replace(/\\b[a-z0-9-]+(\\.[a-z0-9-]+)*\\.(de\\.int\\.)?wahlberger\\.dev\\b/gi, '<host>')\n          .replace(/\\b\\d{1,3}(\\.\\d{1,3}){3}\\b/g, '<ip>');\n};\nconst prompt = [\n  'Role: read-only incident triage for a homelab. Given the Hush event and the host diagnostics below, state the most likely cause class, the evidence, and one next check to run by hand. Do not propose changes to hosts. Answer in at most 12 lines. As the last line, write PROPOSED_ACTION: followed by the single change you would make on the host to fix it, or none. That line is recorded for review and is never executed.',\n  '',\n  `Event: kind=${redact(body.kind)} severity=${redact(body.severity)} status=${redact(body.status)} streak=${redact(body.streak)} source=${redact(body.source)}`,\n  `first_seen=${redact(body.first_seen)} last_seen=${redact(body.last_seen)}`,\n  `problem=${redact(body.problem_key)} service=${redact(body.service)} check=${redact(body.check)}`,\n  `Summary: ${redact(body.summary).slice(0, 4000)}`,\n  `Raw excerpt: ${redact(body.raw_excerpt).slice(0, 4000)}`,\n  '',\n  'Diagnostics:',\n  diag ? redact(diag).slice(0, 8192) : '(none: not available for this host or unit)'\n].join('\\n');\nconst claudeBody = { model: 'claude-haiku-5-5', max_tokens: 1024, messages: [{ role: 'user', content: prompt }] };\nreturn [{ json: { claudeBody, body } }];"
      }
    },
    {
      "id": "claude",
      "name": "Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.ANTHROPIC_BASE_URL || 'https://api.anthropic.com') + '/v1/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.claudeBody }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "report",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst text = (resp.content || []).filter((c) => c.type === 'text').map((c) => c.text).join('\\n');\nconst body = $('Plan').first().json.body;\n// The model's last line is the proposal. It is kept for the audit and never executed.\nconst match = text.match(/^PROPOSED_ACTION:\\s*(.*)$/m);\nconst proposed = match ? match[1].trim().slice(0, 500) : 'none (no PROPOSED_ACTION line)';\nreturn [{ json: { outcome: 'escalate', kind: body.kind, delivery_id: body.delivery_id || null, summary: text.slice(0, 4000), proposed_action: proposed, model: resp.model || null, usage: resp.usage || null } }];"
      }
    },
    {
