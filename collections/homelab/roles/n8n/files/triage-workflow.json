    {
      "id": "plan",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst unitOk = /^[A-Za-z0-9@._-]+$/;\nconst isNas = body.host === 'nas.de.int.wahlberger.dev' || body.host === 'nas';\nconst diagUnit = isNas && body.service && unitOk.test(body.service) ? body.service + '.service' : '';\nreturn [{ json: { body, diag: diagUnit !== '', diagUnit } }];"
      }
    },
    {
      "id": "diag",
      "name": "Diag?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
