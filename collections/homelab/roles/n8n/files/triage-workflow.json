{
  "id": "n8ntriage01",
  "name": "Hush triage (phase 2a, read-only)",
  "nodes": [
    {
      "id": "wh",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "7a1f0e62-5b1e-4d55-9c1e-8e2a6c0f1a01",
      "parameters": {
        "path": "hush",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "verify",
      "name": "Verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst first = $input.first();\n// With the Webhook option rawBody, the exact request bytes are the binary 'data' property.\nconst binKeys = Object.keys(first.binary || {});\nconst raw = binKeys.length ? Buffer.from(first.binary[binKeys[0]].data, 'base64').toString('utf8') : '';\nconst headers = (first.json && first.json.headers) || {};\nconst sig = String(headers['x-hush-signature'] || '');\nconst ts = String(headers['x-hush-timestamp'] || '');\nconst secret = $env.HUSH_N8N_SECRET || '';\nlet ok = false;\nif (secret && raw && /^[0-9]+$/.test(ts) && Math.abs(Date.now() / 1000 - Number(ts)) <= 300) {\n  const mac = 'sha256=' + crypto.createHmac('sha256', secret).update(ts + '.' + raw).digest('hex');\n  ok = sig.length === mac.length && crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(mac));\n}\nlet body = null;\ntry { body = JSON.parse(raw); } catch (e) { body = null; }\nconst valid = ok && body !== null && typeof body === 'object' && body.schema_version === 1\n  && typeof body.problem_key === 'string' && (body.kind === 'alert' || body.kind === 'info');\nreturn [{ json: { ok, valid, body: valid ? body : {} } }];"
      }
    },
    {
      "id": "signed",
      "name": "Signed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "signedc",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
