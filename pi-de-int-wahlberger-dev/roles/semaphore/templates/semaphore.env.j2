{# Rendered by the semaphore role to {{ semaphore_data_dir }}/semaphore.env (0600). #}
{# podman EnvironmentFile format: KEY=VALUE, one per line; the value is the #}
{# rest of the line verbatim (no quoting, no shell/JSON parsing by podman). #}
{# Do NOT edit on the host — re-run Ansible. #}

{# Only OIDC lives here. SEMAPHORE_DB_DIALECT/SEMAPHORE_DB/SEMAPHORE_ADMIN*/ #}
{# SEMAPHORE_ACCESS_KEY_ENCRYPTION/SEMAPHORE_COOKIE_* used to live here too, #}
{# but this image's `server` command does not apply them: on first boot it #}
{# auto-generates its OWN config.json (with its own random secrets and its #}
{# default sqlite path) regardless of these env vars, and never re-reads #}
{# them once that file exists. config.json.j2 + an explicit `semaphore users #}
{# add` CLI call (see tasks/main.yml) replace them. OIDC is the one setting #}
{# this image DOES read fresh from the environment on every boot. #}

# --- OpenID Connect via Pocket ID ------------------------------------------
# Single-line JSON, per Semaphore's documented Pocket ID integration
# (https://pocket-id.org/docs/client-examples/semaphore-ui). username_claim
# maps the OIDC login to a Semaphore username; name_claim is display-only.
SEMAPHORE_OIDC_PROVIDERS={"pocketid":{"display_name":"Sign in with {{ semaphore_oidc_provider_name }}","provider_url":"{{ pocket_id_app_url }}","client_id":"{{ semaphore_oidc_client_id }}","client_secret":"{{ semaphore_oidc_client_secret }}","redirect_url":"{{ semaphore_url }}/api/auth/oidc/pocketid/redirect/","scopes":["openid","profile","email"],"username_claim":"email","name_claim":"given_name"}}
