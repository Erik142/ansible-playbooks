{# Rendered by the semaphore role to {{ semaphore_data_dir }}/semaphore.env (0600). #}
{# podman EnvironmentFile format: KEY=VALUE, one per line; the value is the #}
{# rest of the line verbatim (no quoting, no shell/JSON parsing by podman). #}
{# Holds every secret Semaphore needs so none lands in the world-readable #}
{# Quadlet unit. Do NOT edit on the host — re-run Ansible. #}

# SQLite — no separate database container needed at this scale. The path is
# inside the container's mount point (/etc/semaphore); "config" is only the
# HOST-side directory name, not part of the in-container path.
SEMAPHORE_DB_DIALECT=sqlite
SEMAPHORE_DB=/etc/semaphore/semaphore.sqlite

# Break-glass local admin, created on first boot. Semaphore auto-creates a
# user on Pocket ID login but grants it no project access — this admin is
# what you use to grant it, and there's no way to fully disable local login
# in exchange. See README.md.
SEMAPHORE_ADMIN={{ semaphore_admin_username }}
SEMAPHORE_ADMIN_NAME={{ semaphore_admin_name }}
SEMAPHORE_ADMIN_EMAIL={{ semaphore_admin_email }}
SEMAPHORE_ADMIN_PASSWORD={{ semaphore_admin_password }}

# Encrypts SSH keys/vault passwords Semaphore stores in its own database.
# MUST stay stable — see vault.yml.example.
SEMAPHORE_ACCESS_KEY_ENCRYPTION={{ semaphore_access_key_encryption }}

# Session cookie keys — kept stable so a redeploy doesn't log everyone out.
SEMAPHORE_COOKIE_HASH={{ semaphore_cookie_hash }}
SEMAPHORE_COOKIE_ENCRYPTION={{ semaphore_cookie_encryption }}

# --- OpenID Connect via Pocket ID ------------------------------------------
# Single-line JSON, per Semaphore's documented Pocket ID integration
# (https://pocket-id.org/docs/client-examples/semaphore-ui). username_claim
# maps the OIDC login to a Semaphore username; name_claim is display-only.
SEMAPHORE_OIDC_PROVIDERS={"pocketid":{"display_name":"Sign in with {{ semaphore_oidc_provider_name }}","provider_url":"{{ pocket_id_app_url }}","client_id":"{{ semaphore_oidc_client_id }}","client_secret":"{{ semaphore_oidc_client_secret }}","redirect_url":"{{ semaphore_url }}/api/auth/oidc/pocketid/redirect/","scopes":["openid","profile","email"],"username_claim":"email","name_claim":"given_name"}}
