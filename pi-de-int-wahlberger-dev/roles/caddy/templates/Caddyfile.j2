{# Rendered by Ansible from the caddy_sites variable — do not edit on the host. #}
{
{% if caddy_acme_email | length > 0 %}
    email {{ caddy_acme_email }}
{% endif %}
    # DNS-01 via Cloudflare: this host has no public inbound port for
    # HTTP-01. The token comes from caddy.env, never written here.
    acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}
{% for site in caddy_sites %}
{{ site.host }} {
    reverse_proxy {{ site.upstream }}
{% if site.extra | default("", true) | length > 0 %}
    {{ site.extra }}
{% endif %}
}
{% endfor %}
