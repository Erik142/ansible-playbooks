# The official Caddy image has no DNS provider plugins built in, so it can
# only complete HTTP-01 (needs inbound port 80 from the public internet).
# This host has no public inbound port — it's a home NAS reached over
# ZeroTier/LAN — so it needs DNS-01 instead, which requires a custom build
# with the Cloudflare module baked in via xcaddy.
FROM docker.io/library/caddy:2-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM docker.io/library/caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
