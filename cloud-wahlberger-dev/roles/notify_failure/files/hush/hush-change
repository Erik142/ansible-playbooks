#!/bin/sh
# Implements: HUSH-DEPLOY-027
# Announce a change (deploy, restart, reboot) to Hush as a maintenance window and end it with a result.
# Usage: hush-change start KIND --id ID HOST[:SERVICE]...
#        hush-change finish ID ok|failed
# KIND is "change" (verified after it ends, HUSH-RULES-060, -061) or "adhoc".
# Environment: HUSH_MAINTENANCE_URL (https://hush.example.org/maintenance/windows),
# HUSH_MAINTENANCE_TOKEN_FILE (bearer token of a maintenance client), optional
# HUSH_CHANGE_SECONDS (window length, default 900) and HUSH_CHANGE_REASON (default "change ID").
# HUSH_CHANGE_STATE_DIR (default /var/tmp/hush-change) remembers adhoc windows, because their early
# end takes no result (HUSH-INGEST-027); `finish` for an id it does not know sends the result.
# Repeating `start` with the same id and arguments is safe: Hush answers with the same window.
set -eu

url=${HUSH_MAINTENANCE_URL:?HUSH_MAINTENANCE_URL is required}
token=$(cat "${HUSH_MAINTENANCE_TOKEN_FILE:?HUSH_MAINTENANCE_TOKEN_FILE is required}")

json_escape() {
  # Valid JSON for any input: backslash, quote and every control character below 0x20 are
  # escaped (as hush-post does). Lines are joined with \n.
  printf '%s' "$1" | LC_ALL=C awk '
    BEGIN { ORS = ""
            for (i = 1; i < 32; i++) esc[sprintf("%c", i)] = sprintf("\\u%04x", i)
            esc["\t"] = "\\t"; esc["\\"] = "\\\\"; esc["\""] = "\\\"" }
    { out = ""; n = length($0)
      for (i = 1; i <= n; i++) { c = substr($0, i, 1); out = out (c in esc ? esc[c] : c) }
      if (NR > 1) printf "\\n"
      printf "%s", out }'
}

# request METHOD URL [BODY]: prints the response body, fails with the request on stderr.
request() {
  method=$1; target=$2; body=${3:-}
  out=$(mktemp)
  trap 'rm -f "$out"' EXIT
  code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" |
    curl -sS --max-time 10 -X "$method" "$target" --config - \
      -H "Content-Type: application/json" ${body:+--data-binary "$body"} \
      -o "$out" -w '%{http_code}' 2>"$out.err") || code=000
  case $code in
    2??) cat "$out"; rm -f "$out.err"; return 0 ;;
  esac
  {
    echo "hush-change: $method $target failed (HTTP $code)"
    [ -n "$body" ] && echo "hush-change: request body: $body"
    cat "$out.err" "$out" 2>/dev/null
  } >&2
  rm -f "$out.err"
  return 1
}

valid_id() {
  # Same rule as HUSH-INGEST-023; keeps the id safe in the URL path and the JSON body.
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$' ||
    { echo "hush-change: id must match [A-Za-z0-9][A-Za-z0-9_.-]{0,63}" >&2; exit 2; }
}

state_dir=${HUSH_CHANGE_STATE_DIR:-/var/tmp/hush-change}

usage() { echo "usage: hush-change start KIND --id ID HOST[:SERVICE]... | finish ID ok|failed" >&2; exit 2; }

[ $# -ge 1 ] || usage
cmd=$1; shift
case $cmd in
  start)
    [ $# -ge 4 ] || usage
    kind=$1; shift
    case $kind in change | adhoc) ;; *) echo "hush-change: KIND must be change or adhoc" >&2; exit 2 ;; esac
    [ "$1" = "--id" ] || usage
    id=$2; shift 2
    valid_id "$id"
    seconds=${HUSH_CHANGE_SECONDS:-900}
    case $seconds in
      '' | *[!0-9]* | 0 | 0[0-9]*)
        echo "hush-change: HUSH_CHANGE_SECONDS must be a positive integer" >&2; exit 2 ;;
    esac
    scope=
    for target in "$@"; do
      host=${target%%:*}
      service=
      case $target in *:*) service=${target#*:} ;; esac
      item="{\"host\":\"$(json_escape "$host")\""
      [ -n "$service" ] && item="$item,\"service\":\"$(json_escape "$service")\""
      scope="$scope${scope:+,}$item}"
    done
    reason=${HUSH_CHANGE_REASON:-change $id}
    body=$(printf '{"id":"%s","kind":"%s","scope":[%s],"duration_seconds":%s,"reason":"%s"}' \
      "$(json_escape "$id")" "$kind" "$scope" "$seconds" "$(json_escape "$reason")")
    request POST "$url" "$body" >/dev/null
    if [ "$kind" = adhoc ]; then
      { mkdir -p "$state_dir" && : >"$state_dir/$id.adhoc"; } 2>/dev/null ||
        echo "hush-change: cannot record the adhoc kind in $state_dir" >&2
    else
      rm -f "$state_dir/$id.adhoc" 2>/dev/null || true
    fi
    ;;
  finish)
    [ $# -eq 2 ] || usage
    id=$1; result=$2
    case $result in ok | failed) ;; *) echo "hush-change: result must be ok or failed" >&2; exit 2 ;; esac
    valid_id "$id"
    if [ -e "$state_dir/$id.adhoc" ]; then
      request DELETE "$url/$id" >/dev/null
      rm -f "$state_dir/$id.adhoc"
    else
      request DELETE "$url/$id" "{\"result\":\"$result\"}" >/dev/null
    fi
    ;;
  *) usage ;;
esac
