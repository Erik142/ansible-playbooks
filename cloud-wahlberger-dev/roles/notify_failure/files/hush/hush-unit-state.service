# Implements: HUSH-DEPLOY-040
# Posts the state of the units in HUSH_STATE_UNITS (hook.env) to Hush. Started by the timer; a
# failed run is not restarted because the next run follows within 310 s.
[Unit]
Description=Report unit state to Hush
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/hush/hook.env
ExecStart=/usr/local/bin/hush-unit-state
