# Rendered by the uptime_kuma role to {{ uptime_kuma_data_dir }}/oauth2-proxy.env
# (0600). Do NOT edit on the host — re-run Ansible.
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ pocket_id_app_url }}
OAUTH2_PROXY_CLIENT_ID={{ uptime_kuma_oidc_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ uptime_kuma_oidc_client_secret }}
OAUTH2_PROXY_COOKIE_SECRET={{ uptime_kuma_cookie_secret }}
OAUTH2_PROXY_REDIRECT_URL={{ uptime_kuma_url }}/oauth2/callback
OAUTH2_PROXY_SCOPE=openid email profile
# Pocket ID is a single-tenant homelab IdP with no anonymous signup — it's
# already the real trust boundary, so any account that can authenticate
# against it is allowed through here too.
OAUTH2_PROXY_EMAIL_DOMAINS=*
# forward_auth only ever calls this on /oauth2/auth; Caddy does the real
# proxying to Uptime Kuma itself once that check passes (see
# roles/caddy/README.md), so oauth2-proxy's own upstream is never actually
# used — this is the documented no-op placeholder for that.
OAUTH2_PROXY_UPSTREAMS=static://200
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:{{ uptime_kuma_oauth2_proxy_port }}
# Trusts X-Forwarded-* from Caddy to build correct redirect URLs.
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_COOKIE_SECURE=true
# Only one provider configured — skip the "choose a provider" landing page.
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
