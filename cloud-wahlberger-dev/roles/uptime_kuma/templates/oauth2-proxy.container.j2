[Unit]
Description=oauth2-proxy (Pocket ID auth gate for Uptime Kuma)
After=network-online.target caddy-network.service
Wants=network-online.target
Requires=caddy-network.service
OnFailure=notify-failure@%n.service

[Container]
ContainerName=oauth2-proxy
Image={{ uptime_kuma_oauth2_proxy_image }}
Network=caddy.network
EnvironmentFile={{ uptime_kuma_data_dir }}/oauth2-proxy.env

[Service]
Restart=always

[Install]
WantedBy=default.target
