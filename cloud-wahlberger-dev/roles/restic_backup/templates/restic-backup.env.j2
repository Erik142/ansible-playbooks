# Rendered by the restic_backup role to
# {{ restic_backup_staging_dir }}/restic-backup.env (0600), read by
# restic-backup.service as its EnvironmentFile. RESTIC_REPOSITORY/
# RESTIC_PASSWORD are read automatically by every restic invocation. Do NOT
# edit on the host — re-run Ansible.
RESTIC_REPOSITORY=rest:http://{{ restic_backup_rest_server_username }}:{{ restic_backup_rest_server_password }}@{{ restic_backup_rest_server_host }}:{{ restic_backup_rest_server_port }}/{{ restic_backup_rest_server_username }}/
RESTIC_PASSWORD={{ restic_backup_repo_password }}
