#!/bin/sh
# Rendered by the restic_backup role. Do NOT edit on the host — re-run
# Ansible. RESTIC_REPOSITORY/RESTIC_PASSWORD come from
# restic-backup.service's EnvironmentFile, not this script.
set -eu

# Bootstrap the repository on first run; a no-op every run after.
restic snapshots --latest 1 >/dev/null 2>&1 || restic init

# Captured (not just streamed) so a success email can embed restic's own
# summary — but still echoed below so `journalctl` shows it either way.
# Deliberately NOT `restic backup ... | tee ...`: a pipeline's exit status
# is the LAST command's (tee, which always succeeds), which would silently
# hide a real backup failure from `set -e`.
if ! BACKUP_OUTPUT="$(restic backup \
{% for path in restic_backup_paths %}
  "{{ path }}" \
{% endfor %}
{% for path in restic_backup_exclude %}
  --exclude "{{ path }}" \
{% endfor %}
  2>&1)"; then
  printf '%s\n' "$BACKUP_OUTPUT"
  exit 1
fi
printf '%s\n' "$BACKUP_OUTPUT"

restic forget \
  --keep-daily {{ restic_backup_keep_daily }} \
  --keep-weekly {{ restic_backup_keep_weekly }} \
  --keep-monthly {{ restic_backup_keep_monthly }} \
  --prune

# Verifies the repository's structure/index every run (cheap: no data
# read), plus re-reads and re-hashes a rotating slice of the actual data
# blobs each run — full data-integrity coverage completes roughly every
# 10 nightly runs without ever re-downloading the whole repository in one
# go. Same capture-for-email, fail-the-script pattern as the backup step
# above; a corrupt repository raises through `set -e` into the same
# OnFailure= alert a failed backup would.
if ! CHECK_OUTPUT="$(restic check --read-data-subset={{ restic_backup_check_read_data_subset }} 2>&1)"; then
  printf '%s\n' "$CHECK_OUTPUT"
  exit 1
fi
printf '%s\n' "$CHECK_OUTPUT"
SUMMARY="$(printf '%s\n\nIntegrity check:\n%s\n' "$BACKUP_OUTPUT" "$CHECK_OUTPUT")"

# Only sends if restic_backup_notify_on_success wired up the notify_failure
# role's Resend credentials as a second EnvironmentFile on this service
# (see restic-backup.service.j2) — a missing key means that's off, not an
# error.
if [ -n "${RESEND_API_KEY:-}" ]; then
  HOST="$(hostname -f)"
  NOW="$(date '+%Y-%m-%d %H:%M:%S %Z')"
  SUMMARY_HTML="$(printf '%s' "$SUMMARY" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"

  BODY="$(jq -n \
    --arg from "$NOTIFY_FROM" \
    --arg to "$NOTIFY_TO" \
    --arg unit "restic-backup.service" \
    --arg host "$HOST" \
    --arg time "$NOW" \
    --arg summary "$SUMMARY" \
    --arg summary_html "$SUMMARY_HTML" \
    --rawfile tmpl /etc/restic-backup/success-email-template.html \
    '{
      from: $from,
      to: [$to],
      subject: ("[" + $host + "] " + $unit + " succeeded"),
      text: ($unit + " succeeded on " + $host + " at " + $time + ".\n\nBackup summary:\n" + $summary),
      html: ($tmpl
        | gsub("@@UNIT@@"; $unit)
        | gsub("@@HOST@@"; $host)
        | gsub("@@TIME@@"; $time)
        | gsub("@@SUMMARY@@"; $summary_html))
    }' 2>&1)" || { echo "jq failed building the success email body: $BODY" >&2; exit 0; }

  curl -fsS https://api.resend.com/emails \
    -H "Authorization: Bearer ${RESEND_API_KEY}" \
    -H "Content-Type: application/json" \
    -d "$BODY" || echo "Sending the success email failed (backup itself still succeeded)" >&2
fi
