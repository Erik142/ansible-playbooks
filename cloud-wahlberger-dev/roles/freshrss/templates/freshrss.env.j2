{# Rendered by the freshrss role to {{ freshrss_data_dir }}/freshrss.env (0600). #}
{# podman --env-file format: KEY=VALUE, one per line, value is the rest of the #}
{# line (spaces preserved, no quoting). Do NOT edit on the host. #}
TZ={{ freshrss_timezone }}
TRUSTED_PROXY={{ freshrss_trusted_proxy }}
# Minutes field of the built-in feed-refresh cron; empty disables auto-refresh.
CRON_MIN={{ freshrss_cron_min }}

# First-run bootstrap. The image entrypoint runs these once and only if FreshRSS
# is not already installed / the user does not already exist, so re-runs are
# idempotent. The admin user is created up front because FreshRSS does not
# auto-provision OIDC users, and its name must match the OIDC username claim.
FRESHRSS_INSTALL=--default-user {{ freshrss_admin_user }} --auth-type http_auth --base-url {{ freshrss_app_url }} --db-type sqlite --language {{ freshrss_language }} --api-enabled
FRESHRSS_USER=--user {{ freshrss_admin_user }} --password {{ freshrss_admin_password }} --language {{ freshrss_language }}{% if freshrss_admin_email | length > 0 %} --email {{ freshrss_admin_email }}{% endif %}


# OpenID Connect (Pocket ID).
OIDC_ENABLED=1
OIDC_PROVIDER_METADATA_URL={{ freshrss_oidc_provider_metadata_url }}
OIDC_CLIENT_ID={{ freshrss_oidc_client_id }}
OIDC_CLIENT_SECRET={{ freshrss_oidc_client_secret }}
OIDC_CLIENT_CRYPTO_KEY={{ freshrss_oidc_crypto_key }}
OIDC_SCOPES={{ freshrss_oidc_scopes }}
OIDC_REMOTE_USER_CLAIM={{ freshrss_oidc_remote_user_claim }}
OIDC_X_FORWARDED_HEADERS={{ freshrss_oidc_x_forwarded_headers }}
