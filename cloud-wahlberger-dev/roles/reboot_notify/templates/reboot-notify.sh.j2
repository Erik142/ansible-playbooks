#!/bin/sh
# Rendered by the reboot_notify role. Do NOT edit on the host — re-run
# Ansible. Runs on every shutdown/reboot (see reboot-notify.service), but
# only actually emails when /var/run/reboot-required exists — i.e. this
# specific reboot is (at least in part) unattended-upgrades' own automatic
# reboot for a pending kernel/library update, not an ordinary manual one.
set -eu

[ -f /var/run/reboot-required ] || exit 0

# shellcheck disable=SC1091
. /etc/notify-failure/notify-failure.env
TEMPLATE=/etc/reboot-notify/email-template.html
HOST="$(hostname -f)"
NOW="$(date '+%Y-%m-%d %H:%M:%S %Z')"
PACKAGES="$(cat /var/run/reboot-required.pkgs 2>/dev/null || echo '(unknown)')"

BODY="$(jq -n \
  --arg from "$NOTIFY_FROM" \
  --arg to "$NOTIFY_TO" \
  --arg host "$HOST" \
  --arg time "$NOW" \
  --arg packages "$PACKAGES" \
  --rawfile tmpl "$TEMPLATE" \
  '{
    from: $from,
    to: [$to],
    subject: ("[" + $host + "] Rebooting for a software update"),
    text: ($host + " is rebooting at " + $time + " because of a pending software update.\n\nPackages that required it:\n" + $packages),
    html: ($tmpl
      | gsub("@@HOST@@"; $host)
      | gsub("@@TIME@@"; $time)
      | gsub("@@PACKAGES@@"; $packages))
  }' 2>&1)" || { echo "jq failed building the reboot notice body: $BODY" >&2; exit 0; }

curl -fsS --max-time 15 https://api.resend.com/emails \
  -H "Authorization: Bearer ${RESEND_API_KEY}" \
  -H "Content-Type: application/json" \
  -d "$BODY" || echo "Sending the reboot notice failed (reboot proceeds regardless)" >&2
