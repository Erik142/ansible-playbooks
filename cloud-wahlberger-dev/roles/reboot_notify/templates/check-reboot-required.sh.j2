#!/bin/sh
# Rendered by the reboot_notify role. Do NOT edit on the host — re-run
# Ansible. Debian doesn't ship Ubuntu's update-notifier-common, so nothing
# else creates /var/run/reboot-required — this is what does, via
# needrestart's own kernel-version detection. Runs after every apt/dpkg
# transaction (see reboot-required.hook.j2), including unattended-upgrades'
# own nightly one, so the flag is already in place by the time its own
# Automatic-Reboot check looks for it.
#
# Also emails the "reboot needed" heads-up synchronously, right here, the
# moment a reboot is first known to be needed — not via a shutdown-time
# systemd hook. That used to be a separate reboot-notify.service ordered
# Before=shutdown.target, on the theory that ordering guarantees it runs as
# part of every shutdown transaction. Confirmed unreliable in practice
# (2026-09): Before= is only a soft ordering hint, and it silently lost the
# race — never ran at all — on both pi-de-int-wahlberger-dev and
# nas-de-int-wahlberger-dev, when the real shutdown transaction was busy
# with several other services stopping at the same time. This apt hook has
# no such race: it runs to completion as an ordinary foreground script, and
# as a bonus gives advance notice instead of a same-instant one.
set -eu

ALREADY_FLAGGED=false
[ -f /var/run/reboot-required ] && ALREADY_FLAGGED=true

OUTPUT="$(needrestart -b -r a 2>/dev/null || true)"
# KSTA: 1 = running kernel matches installed, 2 = ABI-only bump, 3 = a
# genuinely different kernel version is installed — the only case that
# actually needs a reboot.
KSTA="$(printf '%s\n' "$OUTPUT" | sed -n 's/^NEEDRESTART-KSTA: //p')"
[ "${KSTA:-0}" -ge 3 ] || exit 0

KCUR="$(printf '%s\n' "$OUTPUT" | sed -n 's/^NEEDRESTART-KCUR: //p')"
KEXP="$(printf '%s\n' "$OUTPUT" | sed -n 's/^NEEDRESTART-KEXP: //p')"
PACKAGES="$(printf 'Kernel: running %s, installed %s\n' "${KCUR:-?}" "${KEXP:-?}")"
printf '%s' "$PACKAGES" > /var/run/reboot-required.pkgs
touch /var/run/reboot-required

# Only email the first time this is detected since the last actual reboot
# (/var/run is tmpfs, so this naturally resets every reboot) — otherwise
# every later apt/dpkg transaction while the reboot is still pending would
# send a duplicate.
[ "$ALREADY_FLAGGED" = false ] || exit 0

# shellcheck disable=SC1091
# Heads-up goes to hush as an info event with the label kind=heads_up: hush
# sends it at once, even inside a maintenance window (HUSH-RULES-050), and skips
# triage. hook.env supplies HUSH_URL and HUSH_TOKEN_FILE.
set -a
. /etc/hush/hook.env
set +a
HOST="${HUSH_HOST:-$(hostname -f)}"
printf '%s\n' "$OUTPUT" | HUSH_LABELS="kind=heads_up" HUSH_MESSAGE="$HOST needs a reboot for a pending software update. This is advance notice only: it has NOT rebooted yet." \
  /usr/local/bin/hush-post info "$HOST" reboot-pending \
  || echo "Posting the reboot notice to hush failed (reboot proceeds regardless)" >&2
