---
# EXAMPLE Vault contents — copy the structure, NOT the placeholder values.
#
# This file is a committed, plaintext template. The REAL file is the encrypted
# sibling `vault.yml` (same directory). Create it with:
#
#     ansible-vault create inventories/production/group_vars/all/vault.yml
#
# then paste real values in. Every key is referenced from vars.yml under a
# friendly (non-vault_) name. Generate fresh secrets locally so they never pass
# through anyone else's hands; suggested commands are shown per value.

# Pocket ID data-encryption key.  openssl rand -hex 32
# MIGRATING an already-running Pocket ID? Use the EXISTING value instead, or you
# lose access to encrypted data:
#     cat secret_files/pocket_id_encryption.key
vault_pocket_id_encryption_key: "REPLACE-64-hex-chars"

# FreshRSS OIDC client secret — copy it from the Pocket ID admin UI after
# registering the FreshRSS client (it is generated by Pocket ID, not by you).
vault_freshrss_oidc_client_secret: "REPLACE-with-pocket-id-client-secret"

# FreshRSS internal OIDC crypto key.  openssl rand -hex 32
vault_freshrss_oidc_crypto_key: "REPLACE-64-hex-chars"

# FreshRSS break-glass admin password (alphanumeric — it is passed through the
# image entrypoint's shell, so avoid quotes/$/spaces).
#     LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24; echo
vault_freshrss_admin_password: "REPLACE-with-24-char-alnum-password"

# Cloudflare API token (cloudflare_dns role) — a scoped token with
# Zone:DNS:Edit on the wahlberger.dev zone, needs no other permission. Reuse
# the existing token from nas-de-int-wahlberger-dev/pi-de-int-wahlberger-dev's
# vault instead of minting a new one — same zone, same purpose.
vault_cloudflare_dns_api_token: "REPLACE-with-the-existing-cloudflare-token"

# Resend API key for failure notification emails. Same key as
# nas-de-int-wahlberger-dev and pi-de-int-wahlberger-dev — one Resend account.
vault_notify_failure_resend_api_key: "REPLACE-with-a-resend-api-key"
