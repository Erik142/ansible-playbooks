#!/bin/sh
# Rendered by the restic_backup role. Do NOT edit on the host — re-run
# Ansible. RESTIC_REPOSITORY/RESTIC_PASSWORD come from
# restic-backup.service's EnvironmentFile, not this script.
set -eu

# Consistent copy of each SQLite database (SH-FR-78). A plain file copy of a
# database in WAL mode can miss committed pages that still sit in the -wal
# file; sqlite3 .backup reads through SQLite itself and writes a complete,
# self-contained file. The source is opened read-only, the copy is written under
# a .partial name, integrity-checked and only then renamed over the previous
# copy, so a failure never leaves a half-written file where restic looks.
copy_sqlite() {
  src="$1"
  dest="$2"
  tmp="$dest.partial"
  rm -f "$tmp"
  sqlite3 -readonly "$src" ".timeout 30000" ".backup '$tmp'"
  if [ "$(sqlite3 "$tmp" 'PRAGMA integrity_check;')" != "ok" ]; then
    echo "integrity_check failed on the copy of $src" >&2
    rm -f "$tmp"
    exit 1
  fi
  chmod 0600 "$tmp"
  mv -f "$tmp" "$dest"
}

{% for db in restic_backup_sqlite_databases %}
{% if restic_backup_sqlite_required | bool %}
[ -f {{ db.src | quote }} ] || { echo "SQLite database {{ db.src }} is missing" >&2; exit 1; }
copy_sqlite {{ db.src | quote }} {{ (restic_backup_staging_dir ~ '/' ~ db.name) | quote }}
{% else %}
if [ -f {{ db.src | quote }} ]; then
  copy_sqlite {{ db.src | quote }} {{ (restic_backup_staging_dir ~ '/' ~ db.name) | quote }}
else
  echo "SQLite database {{ db.src }} is missing; skipped (restic_backup_sqlite_required is false)" >&2
fi
{% endif %}
{% endfor %}

# Bootstrap the repository on first run; a no-op every run after.
restic snapshots --latest 1 >/dev/null 2>&1 || restic init

# Captured (not just streamed) so a success email can embed restic's own
# summary — but still echoed below so `journalctl` shows it either way.
# Deliberately NOT `restic backup ... | tee ...`: a pipeline's exit status
# is the LAST command's (tee, which always succeeds), which would silently
# hide a real backup failure from `set -e`.
if ! BACKUP_OUTPUT="$(restic backup \
{% for path in restic_backup_paths %}
  {{ path | quote }} \
{% endfor %}
{% for path in restic_backup_exclude %}
  --exclude {{ path | quote }} \
{% endfor %}
  2>&1)"; then
  printf '%s\n' "$BACKUP_OUTPUT"
  exit 1
fi
printf '%s\n' "$BACKUP_OUTPUT"

# Verifies the repository's structure/index every run (cheap: no data
# read), plus re-reads and re-hashes a rotating slice of the actual data
# blobs each run — full data-integrity coverage completes roughly every
# 10 daily runs without ever re-downloading the whole repository in one
# go. Same capture-for-email, fail-the-script pattern as the backup step
# above; a corrupt repository raises through `set -e` into the same
# OnFailure= alert a failed backup would.
if ! CHECK_OUTPUT="$(restic check --read-data-subset={{ restic_backup_check_read_data_subset }} 2>&1)"; then
  printf '%s\n' "$CHECK_OUTPUT"
  exit 1
fi
printf '%s\n' "$CHECK_OUTPUT"
SUMMARY="$(printf '%s\n\nIntegrity check:\n%s\n' "$BACKUP_OUTPUT" "$CHECK_OUTPUT")"

{% if restic_backup_notify_on_success %}
# Success goes to hush as an "ok" event, signed with the backup source's HMAC
# secret. hush sends the e-mail; a missing success is an absence alert there. A
# failed post never fails the backup itself.
TMP="$(mktemp)"
jq -n --arg host "$(hostname -f)" --arg msg "restic-backup succeeded" \
  --arg logs "$SUMMARY" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '{schema: "hush.event.v1", host: $host, check: "restic-backup", service: "", status: "ok",
    message: $msg, log_excerpt: $logs, occurred_at: $ts}' > "$TMP"
/usr/local/bin/hush-post {{ restic_backup_hush_source }} hmac "$TMP" {{ restic_backup_hush_secret_file }} \
  || echo "posting the success event to hush failed (backup itself succeeded)" >&2
rm -f "$TMP"
{% endif %}
