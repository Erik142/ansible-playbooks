[Unit]
Description=Beszel Agent
Wants=network-online.target
After=network-online.target
# Emails ewahlberger@gmail.com via Resend after 5 consecutive failures —
# see the notify_failure role.
OnFailure=notify-failure@%n.service

[Service]
# The hub (cloud-wahlberger-dev) connects to this agent over the network —
# see roles/beszel_hub/README.md for why that direction, not the reverse.
Environment="PORT={{ beszel_agent_port }}"
# The hub's SSH public key: only THIS hub is trusted to connect.
Environment="KEY={{ beszel_agent_hub_key }}"
ExecStart={{ beszel_agent_bin_path }}
User={{ beszel_agent_user }}
Restart=on-failure
RestartSec=5
StateDirectory=beszel-agent

# Sandboxing settings copied verbatim from Beszel's own installer
# (supplemental/scripts/install-agent.sh) — no reason to weaken them.
KeyringMode=private
LockPersonality=yes
ProtectClock=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
RemoveIPC=yes
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
