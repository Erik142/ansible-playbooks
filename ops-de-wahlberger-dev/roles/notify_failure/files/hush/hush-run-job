#!/bin/sh
# Run a backup (or any) command and report ok or problem from its exit code, with the last 50
# output lines as log excerpt (HUSH-DEPLOY-024).
# Usage: hush-run-job HOST CHECK -- COMMAND [ARGS...]
set -u
host=$1; check=$2; shift 2
[ "${1:-}" = "--" ] && shift
here=$(dirname "$0")
out=$(mktemp)
trap 'rm -f "$out"' EXIT
"$@" >"$out" 2>&1
code=$?
if [ "$code" -eq 0 ]; then
  HUSH_MESSAGE="$check finished" "$here/hush-post" ok "$host" "$check" <"$out"
else
  HUSH_MESSAGE="$check failed with exit code $code" "$here/hush-post" problem "$host" "$check" <"$out"
fi
exit "$code"
