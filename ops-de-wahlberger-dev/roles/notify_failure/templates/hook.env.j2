# Rendered by the notify_failure role. Read by the hush hook scripts and units.
HUSH_URL={{ notify_failure_hush_url }}/ingest/{{ notify_failure_hush_source }}
HUSH_TOKEN_FILE=/etc/hush/systemd.token
# The host name as hush knows it. Set here so no hook needs the hostname binary.
HUSH_HOST={{ inventory_hostname }}
