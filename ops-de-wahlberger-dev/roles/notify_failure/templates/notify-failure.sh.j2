#!/bin/sh
# Rendered by the notify_failure role. Do NOT edit on the host; re-run Ansible.
# Usage: notify-failure.sh <failed-unit-name>
# Reports the unit's problem to hush. Whether an e-mail goes out is decided by hush.
set -eu
exec /usr/local/bin/hush-systemd-event problem "${1:?usage: notify-failure.sh <unit-name>}"
