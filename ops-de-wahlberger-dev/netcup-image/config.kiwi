<?xml version="1.0" encoding="utf-8"?>

<!--
Netcup variant of the openSUSE Tumbleweed image for the netcup VPS (KVM, x86_64, BIOS+UEFI).

Derived from the Hetzner variant (../image/config.kiwi), which is derived from
openSUSE:Factory/kiwi-templates-Minimal (see ../image/README.md for the upstream revision).
Differences from the Hetzner variant:
  - no cloud-init (netcup has no cloud-init / metadata service): the admin user, its SSH key
    (via the build.sh ssh-pubkey option) and the sshd policy are baked into the image
  - admin user erikwahlberger in group wheel, sudo NOPASSWD, key-only login, root locked
  - no Hetzner datasource overlay
Everything else (btrfs, snapper, BIOS+EFI hybrid, SELinux, root growth at first boot) is unchanged.
-->

<image schemaversion="7.4" name="openSUSE-Tumbleweed-Netcup" displayname="openSUSE Tumbleweed Netcup">
    <description type="system">
        <author>Erik Wahlberger</author>
        <contact>ewahlberger@gmail.com</contact>
        <specification>openSUSE Tumbleweed (btrfs, snapper, key-only admin user) for netcup VPS</specification>
    </description>
    <profiles>
        <profile name="Netcup" description="Minimal btrfs+snapper image with a baked-in admin key for netcup VPS (x86_64, BIOS+UEFI)" arch="x86_64"/>
    </profiles>
    <preferences profiles="Netcup" arch="x86_64">
        <!-- build.sh rewrites this with the image-version option -->
        <version>1.0.0</version>
        <packagemanager>zypper</packagemanager>
        <bootloader-theme>openSUSE</bootloader-theme>
        <rpm-excludedocs>true</rpm-excludedocs>
        <locale>en_US</locale>
        <!--
          Same filesystem and boot attributes as the Hetzner variant. Root is grown on first boot
          by dracut-kiwi-oem-repart. netcup's disk size (1 TB here) is taken up at first boot.
          UNVERIFIED: netcup's network is assumed to be DHCP through NetworkManager. If netcup
          needs a static IPv4/IPv6 configuration, add it in root/etc/NetworkManager/system-connections/.
        -->
        <type
            image="oem"
            filesystem="btrfs"
            firmware="uefi"
            efipartsize="512"
            bootpartition="false"
            bootkernel="custom"
            devicepersistency="by-uuid"
            btrfs_quota_groups="true"
            btrfs_root_is_snapshot="true"
        >
            <bootloader name="grub2" timeout="1"/>
            <systemdisk>
                <volume name="home"/>
                <volume name="root"/>
                <volume name="opt"/>
                <volume name="srv"/>
                <volume name="boot/grub2/i386-pc"/>
                <volume name="boot/grub2/x86_64-efi" mountpoint="boot/grub2/x86_64-efi"/>
                <volume name="usr/local"/>
                <volume name="var" copy_on_write="false"/>
            </systemdisk>
            <size unit="G">6</size>
        </type>
    </preferences>

    <repository type="rpm-md" alias="repo-oss" priority="99" imageinclude="false">
        <source path="https://download.opensuse.org/tumbleweed/repo/oss/"/>
    </repository>

    <!-- Common set, as in the Hetzner variant, minus cloud-init -->
    <packages type="image">
        <package name="patterns-base-base"/>
        <package name="patterns-base-selinux"/>
        <package name="audit"/>
        <package name="aaa_base-extras"/>
        <package name="acl"/>
        <package name="chrony"/>
        <package name="curl"/>
        <package name="dracut"/>
        <package name="fipscheck"/>
        <package name="group(mail)"/>
        <package name="pam_pwquality"/>
        <package name="cracklib-dict-small"/>
        <package name="iputils"/>
        <package name="vim-small"/>
        <package name="haveged"/>
        <package name="less"/>
        <package name="tar"/>
        <package name="parted"/>
        <package name="timezone"/>
        <package name="iproute2"/>
        <package name="openssh"/>
        <package name="rsync"/>
        <package name="dosfstools"/>
        <package name="procps"/>
        <package name="lsof"/>
        <package name="live-add-yast-repos"/>
        <package name="systemd-logger"/>
        <package name="zypper-needs-restarting"/>
        <package name="nftables"/>
        <package name="iptables"/>
        <package name="zypp-excludedocs"/>
        <package name="zypp-no-recommends"/>
        <package name="combustion &gt;= 1.2"/>
        <package name="NetworkManager"/>
        <package name="dracut-kiwi-oem-repart"/>
        <package name="update-bootloader"/>
        <!-- NETCUP: sudo for the admin user (Ansible become) -->
        <package name="sudo"/>
    </packages>

    <!-- GRUB (BIOS + EFI) -->
    <packages type="image">
        <package name="grub2"/>
        <package name="grub2-branding-openSUSE"/>
        <package name="grub2-x86_64-efi"/>
        <package name="shim"/>
    </packages>

    <!-- btrfs + snapper -->
    <packages type="image">
        <package name="btrfsprogs"/>
        <package name="btrfsmaintenance"/>
        <package name="snapper-zypp-plugin"/>
        <package name="snapper"/>
        <package name="grub2-snapper-plugin"/>
    </packages>

    <!-- KVM guest support (netcup is KVM). Kernel and agent from the upstream Cloud set, without cloud-init. -->
    <packages type="image">
        <package name="kernel-default-base"/>
        <package name="qemu-guest-agent"/>
    </packages>

    <packages type="bootstrap">
        <package name="filesystem"/>
        <package name="glibc-locale-base"/>
        <package name="ca-certificates-mozilla"/>
        <package name="openSUSE-release"/>
        <package name="awk"/>
        <package name="coreutils"/>
        <package name="gzip"/>
        <!-- UNVERIFIED: kept from the Hetzner variant. Check whether a KVM-flavour release package
             is more correct for netcup; see README "UNVERIFIED". -->
        <package name="openSUSE-release-appliance-openstack"/>
    </packages>
</image>
