#!/bin/sh
# Rendered by the reboot_notify role. Do NOT edit on the host — re-run
# Ansible. Called directly by security's zypper-dup-request-reboot.sh, right
# BEFORE it requests a reboot via rebootmgrctl — not a shutdown-time systemd
# hook (this role's design until 2026-09; confirmed unreliable in practice,
# see README.md). Only actually emails when zypper itself says a reboot is
# genuinely needed, matching the same check the caller already made.
set -eu

if OUTPUT="$(zypper needs-rebooting 2>&1)"; then
  RC=0
else
  RC=$?
fi

# 102 = ZYPPER_EXIT_INF_REBOOT_NEEDED. Anything else (0 = not needed, or a
# real zypper error) means there's nothing accurate to email about.
[ "$RC" -eq 102 ] || exit 0

# shellcheck disable=SC1091
# Heads-up goes to hush as an info event with the label kind=heads_up: hush
# sends it at once, even inside a maintenance window (HUSH-RULES-050), and skips
# triage. hook.env supplies HUSH_URL and HUSH_TOKEN_FILE.
set -a
. /etc/hush/hook.env
set +a
HOST="${HUSH_HOST:-$(hostname -f)}"
printf '%s\n' "$OUTPUT" | HUSH_LABELS="kind=heads_up" HUSH_MESSAGE="$HOST needs a reboot for a pending software update. The reboot is requested via rebootmgr and happens inside the maintenance window, not immediately." \
  /usr/local/bin/hush-post info "$HOST" reboot-pending \
  || echo "Posting the reboot notice to hush failed (reboot proceeds regardless)" >&2
