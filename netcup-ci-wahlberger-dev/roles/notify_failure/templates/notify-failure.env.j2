# Rendered by the notify_failure role to
# /etc/notify-failure/notify-failure.env (0600), read by
# notify-failure@.service as its EnvironmentFile. Do NOT edit on the host —
# re-run Ansible.
RESEND_API_KEY={{ notify_failure_resend_api_key }}
# Quoted: unlike a bare address, "Display Name <addr>" contains a space —
# both systemd's EnvironmentFile= and plain shell `.` sourcing (see
# reboot_notify) need the quotes to parse it as one value.
NOTIFY_FROM="{{ notify_failure_from_address }}"
NOTIFY_TO={{ notify_failure_to_address }}
NOTIFY_LOG_LINES={{ notify_failure_log_lines }}
# NOTIFY_CRASH_THRESHOLD deliberately NOT here — it's set per-unit via
# Environment= in notify-failure@.service.j2/notify-failure-immediate@.service.j2
# instead. EnvironmentFile= always wins over a same-named Environment= on
# this systemd (257) regardless of which appears later in the unit file —
# confirmed empirically, contradicting the "later wins" assumption in an
# earlier version of this role — so the immediate variant's
# Environment=NOTIFY_CRASH_THRESHOLD=1 could never actually override a
# value also present here. Keeping it out of this shared file entirely
# removes the conflict instead of relying on precedence.
NOTIFY_CRASH_WINDOW_SECONDS={{ notify_failure_crash_window_seconds }}
