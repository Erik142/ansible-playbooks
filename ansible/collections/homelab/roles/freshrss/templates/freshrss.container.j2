[Unit]
Description=FreshRSS feed aggregator
After=network-online.target caddy-network.service
Wants=network-online.target
Requires=caddy-network.service
# Emails ewahlberger@gmail.com via Resend after 5 consecutive failures; see the
# notify_failure role.
OnFailure=notify-failure@%n.service

[Container]
ContainerName=freshrss
Image={{ freshrss_image }}
Network=caddy.network
# Persistent data (SQLite DB, config.php), bind-mounted from the host.
Volume={{ freshrss_db_dir }}:/var/www/FreshRSS/data:Z
# All env (config and secrets) comes from this root-only 0600 file, so secrets never
# land in the world-readable unit file.
EnvironmentFile={{ freshrss_data_dir }}/freshrss.env

[Service]
# SIGTERM (143) is the normal stop of a container; systemd would count it as a failure and fire OnFailure=.
SuccessExitStatus=143
Restart=always

[Install]
WantedBy=default.target
