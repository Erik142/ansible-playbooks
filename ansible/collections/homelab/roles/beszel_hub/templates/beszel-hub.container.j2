[Unit]
Description=Beszel monitoring hub
After=network-online.target caddy-network.service
Wants=network-online.target
Requires=caddy-network.service
# Emails ewahlberger@gmail.com via Resend after 5 consecutive failures; see the
# notify_failure role.
OnFailure=notify-failure@%n.service

[Container]
ContainerName=beszel-hub
Image={{ beszel_hub_image }}
Network=caddy.network
Volume={{ beszel_hub_data_dir }}:/beszel_data:Z
# Lets this rootful container reach the host's own beszel_agent (also running on this
# machine), the same way Docker's host.docker.internal works.
AddHost=host.containers.internal:host-gateway
Environment=APP_URL={{ beszel_hub_url }}
# Beszel's default OAuth login opens a popup. On some browsers that popup becomes the
# only tab, so "closing the popup" closes the whole browser. A plain full-page redirect
# avoids it.
Environment=OAUTH_DISABLE_POPUP={{ beszel_hub_oauth_disable_popup | ternary('true', 'false') }}
# Without this, the users collection's create rule is superusers-only via the API. That
# blocks OAuth signups and the first OAuth login to an existing account.
Environment=USER_CREATION={{ beszel_hub_oauth_user_creation | ternary('true', 'false') }}
# Only touches the users collection's password login. The _superusers collection that
# backs /_/ keeps its own password login, so emergency access is not locked out.
Environment=DISABLE_PASSWORD_AUTH={{ beszel_hub_disable_password_auth | ternary('true', 'false') }}

[Service]
# SIGTERM (143) is the normal stop of a container; systemd would count it as a failure and fire OnFailure=.
SuccessExitStatus=143
Restart=always

[Install]
WantedBy=default.target
